# User-provided private AoC reference material: NEVER commit, publish or ship.
reference/
# Raw data downloads (Natural Earth, ETOPO, ...)
.cache/
node_modules/
dist/
test-results/
playwright-report/
coverage/
*.local
.DS_Store
Thumbs.db
# The critic's output stays on disk, not in git (ADR-914): only its report, its JSON, its scripts and
# its scenario files are committed. Logs, JSON dumps, screenshots and trace folders are read on disk.
critic/*
!critic/CRITIC_REPORT.md
!critic/CRITIC_REPORT.json
!critic/scripts/
!critic/*.warsim-scenario
# The critic's bulky byproducts: saved sim states and saves (hundreds of MB a run), build
# copies of the game, and its git worktree. Its logs, JSON, scripts and scenarios stay committable.
critic/*.bin
critic/*.wsz
critic/*_dist/
critic/*_olddist/
critic/*_wtdist/
critic/wt/
# The replay's yearly starts (R68a, ADR-983): built at deploy, never committed.
public/data/scenarios/1938h/start/
